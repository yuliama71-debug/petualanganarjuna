                                <span class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-400/50 flex items-center justify-center font-heading text-amber-300 text-xs flex-shrink-0">${String.fromCharCode(65 + idx)}</span>
                                <span>${optText}</span>
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function checkBossAnswer(selectedIdx) {
            const currentQ = BOSS_QUESTIONS_BANK[gameState.bossIndex];
            const player = getCurrentPlayer();

            if (selectedIdx === currentQ.correctIndex) {
                player.score += 20;
                showFeedbackModal(true, "⚔️ JAWABAN BENER!", `Luar biasa! Wangsulanmu bener banget. (+20 Poin)`, () => {
                    gameState.bossIndex++;
                    renderBossQuestion();
                });
            } else {
                player.lives -= 1;
                showFeedbackModal(false, "❌ DURUNG BENER!", `Wangsulan durung trep. Tetep semangat! (-1 Nyawa)`, () => {
                    gameState.bossIndex++;
                    renderBossQuestion();
                });
            }
        }

        /* Level Completion Transition Screen */
        function renderLevelCompleteScreen(completedLevel, title, subtitle, nextLevel) {
            showHeader(true);
            updateHeaderUI();

            const app = document.getElementById('appContainer');
            app.innerHTML = `
                <div class="glass-card rounded-3xl p-8 w-full max-w-lg text-center border-amber-500/40 animate-star">
                    <span class="text-6xl mb-3 block">🎉</span>
                    <h2 class="font-heading text-3xl font-extrabold text-amber-400 mb-2">${title}</h2>
                    <p class="text-slate-200 text-sm mb-6">${subtitle}</p>

                    <div class="p-4 bg-slate-900/80 rounded-2xl border border-amber-500/30 mb-6 flex justify-around">
                        <div>
                            <span class="text-xs text-slate-400 block">Skor Saiki:</span>
                            <span class="font-heading font-bold text-2xl text-amber-300">⭐ ${getCurrentPlayer().score}</span>
                        </div>
                        <div>
                            <span class="text-xs text-slate-400 block">Sisa Nyawa:</span>
                            <span class="font-heading font-bold text-2xl text-red-400">❤️ ${getCurrentPlayer().lives}</span>
                        </div>
                    </div>

                    <button onclick="playSound('click'); startLevel(${nextLevel});" class="w-full py-4 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-bold font-heading text-lg rounded-xl shadow-lg btn-game">
                        ${nextLevel === 4 ? '⚔️ MENUJU BOSS BATTLE' : `➡️ LANJUT LEVEL ${nextLevel}`}
                    </button>
                </div>
            `;
        }

        /* Game Over Screen */
        function renderGameOverScreen(failedLevel) {
            showHeader(true);
            updateHeaderUI();

            const app = document.getElementById('appContainer');
            app.innerHTML = `
                <div class="glass-card rounded-3xl p-8 w-full max-w-lg text-center border-red-500/40">
                    <span class="text-6xl mb-3 block animate-bounce">💔</span>
                    <h2 class="font-heading text-3xl font-extrabold text-red-400 mb-2">NYAWA WIS ENTEK!</h2>
                    <p class="text-slate-300 text-sm mb-6">Aja putus asa, coba maneh kanggo ngrampungake misi iki!</p>

                    <div class="flex justify-center space-x-3">
                        <button onclick="playSound('click'); getCurrentPlayer().lives = 5; startLevel(${failedLevel});" class="py-3 px-6 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-heading rounded-xl btn-game">
                            🔄 BALENI LEVEL ${failedLevel}
                        </button>
                        <button onclick="playSound('click'); renderHomeScreen();" class="py-3 px-6 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl border border-amber-500/30 btn-game">
                            🏠 BERANDA
                        </button>
                    </div>
                </div>
            `;
        }
    </script>

    <script>
        /* ==========================================================
           VIEW M & N: HASIL AKHIR & MODE DUEL
           ========================================================== */
        function renderFinalResultsScreen() {
            showHeader(true);
            updateHeaderUI();

            const player1 = gameState.players[1];
            const player2 = gameState.players[2];

            // Save score to local storage
            saveScoreToLeaderboard(getCurrentPlayer());

            const app = document.getElementById('appContainer');

            if (gameState.mode === 'DUEL' && gameState.currentPlayerIndex === 1) {
                // Player 1 finished, turn for Player 2!
                app.innerHTML = `
                    <div class="glass-card rounded-3xl p-8 w-full max-w-lg text-center border-amber-500/40 animate-star">
                        <span class="text-6xl mb-3 block">🏁</span>
                        <h2 class="font-heading text-3xl font-extrabold text-amber-400 mb-2">${player1.name} RAMPUNG!</h2>
                        <p class="text-slate-200 text-sm mb-4">Skor ${player1.name}: <b class="text-amber-300">${player1.score} Poin</b></p>
                        
                        <div class="my-6 p-4 bg-purple-950/60 rounded-2xl border border-purple-500/40">
                            <p class="font-heading text-xl text-amber-300 font-bold">⚔️ GILIRAN ${player2.name.toUpperCase()}!</p>
                            <p class="text-xs text-slate-300 mt-1">Siapna dirimu kanggo miwiti petualangan wayang!</p>
                        </div>

                        <button onclick="playSound('click'); gameState.currentPlayerIndex = 2; renderMapScreen();" class="w-full py-4 bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 font-bold font-heading text-lg rounded-xl btn-game">
                            MULAI GILIRAN ${player2.name.toUpperCase()} 🏹
                        </button>
                    </div>
                `;
                return;
            }

            // SOLO or DUEL Completed (Both players)
            if (gameState.mode === 'DUEL') {
                saveScoreToLeaderboard(player2);
                let winnerText = "";
                if (player1.score > player2.score) winnerText = `🏆 PEMENANG: ${player1.name.toUpperCase()}`;
                else if (player2.score > player1.score) winnerText = `🏆 PEMENANG: ${player2.name.toUpperCase()}`;
                else winnerText = "🤝 HASIL IMBANG!";

                app.innerHTML = `
                    <div class="glass-card glass-card-gold rounded-3xl p-8 w-full max-w-xl text-center border-amber-400 animate-star">
                        <span class="text-6xl mb-3 block">⚔️</span>
                        <h2 class="font-heading text-3xl font-extrabold text-amber-300 mb-1">HASIL DUEL</h2>
                        <p class="text-xs text-slate-200 mb-6">Pertandhingan Petualang Wayang Jawa</p>

                        <div class="grid grid-cols-2 gap-4 mb-6">
                            <div class="p-4 bg-slate-900/90 rounded-2xl border ${player1.score >= player2.score ? 'border-amber-400' : 'border-slate-700'}">
                                <h3 class="font-heading font-bold text-amber-300 text-lg">${player1.name}</h3>
                                <p class="text-3xl font-extrabold font-heading text-amber-400 mt-2">⭐ ${player1.score}</p>
                                <span class="text-xs text-slate-400">Sisa Nyawa: ❤️ ${player1.lives}</span>
                            </div>
                            <div class="p-4 bg-slate-900/90 rounded-2xl border ${player2.score >= player1.score ? 'border-amber-400' : 'border-slate-700'}">
                                <h3 class="font-heading font-bold text-amber-300 text-lg">${player2.name}</h3>
                                <p class="text-3xl font-extrabold font-heading text-amber-400 mt-2">⭐ ${player2.score}</p>
                                <span class="text-xs text-slate-400">Sisa Nyawa: ❤️ ${player2.lives}</span>
                            </div>
                        </div>

                        <div class="p-4 bg-amber-500/20 border border-amber-400/50 rounded-2xl mb-6">
                            <h3 class="font-heading font-extrabold text-2xl text-amber-300">${winnerText}</h3>
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            <button onclick="playSound('click'); renderLeaderboardScreen();" class="p-3 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                                🏆 PAPAN SKOR
                            </button>
                            <button onclick="playSound('click'); renderRegistrationScreen();" class="p-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-heading rounded-xl text-xs btn-game">
                                🔄 MAIN MANEH
                            </button>
                            <button onclick="playSound('click'); renderHomeScreen();" class="p-3 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                                🏠 BERANDA
                            </button>
                        </div>
                    </div>
                `;
            } else {
                // SOLO Victory
                const p = player1;
                const badgeTitle = p.unlockedLevel >= 4 ? "🏆 PANGERTEN WAYANG JAWA" : "⭐ PETUALANG WAYANG";

                app.innerHTML = `
                    <div class="glass-card glass-card-gold rounded-3xl p-8 w-full max-w-lg text-center border-amber-400 animate-star">
                        <span class="text-6xl mb-3 block">🎉</span>
                        <h2 class="font-heading text-3xl font-extrabold text-amber-300 mb-1">SELAMAT, ${p.name.toUpperCase()}!</h2>
                        <p class="text-amber-200 text-sm font-bold mb-4">${badgeTitle}</p>
                        <p class="text-slate-200 text-xs mb-6">Kowe wis kasil ngrampungake kabeh misi petualangan wayang Jawa!</p>

                        <div class="p-4 bg-slate-950/80 rounded-2xl border border-amber-500/30 space-y-2 mb-6">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Mode Permainan:</span>
                                <span class="font-bold text-amber-300">SOLO</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Skor Akhir:</span>
                                <span class="font-bold text-amber-300 text-lg">⭐ ${p.score}</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Sisa Nyawa:</span>
                                <span class="font-bold text-red-400">❤️ ${p.lives}</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            <button onclick="playSound('click'); renderLeaderboardScreen();" class="p-3 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                                🏆 PAPAN SKOR
                            </button>
                            <button onclick="playSound('click'); renderRegistrationScreen();" class="p-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-heading rounded-xl text-xs btn-game">
                                🔄 MAIN MANEH
                            </button>
                            <button onclick="playSound('click'); renderHomeScreen();" class="p-3 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                                🏠 BERANDA
                            </button>
                        </div>
                    </div>
                `;
            }
        }

        /* ========================================================
           VIEW O: PAPAN SKOR (LEADERBOARD)
           ======================================================== */
        function getLeaderboard() {
            try {
                const data = localStorage.getItem('arjuna_wayang_scores');
                return data ? JSON.parse(data) : [];
            } catch(e) {
                return [];
            }
        }

        function saveScoreToLeaderboard(player) {
            if (!player || !player.name) return;
            let board = getLeaderboard();
            
            const badgeTitle = player.unlockedLevel >= 4 ? "Pangerten Wayang Jawa" : "Petualang Wayang";
            
            board.push({
                name: player.name,
                mode: gameState.mode,
                score: player.score,
                badge: badgeTitle,
                date: new Date().toLocaleDateString('id-ID')
            });

            // Sort by highest score
            board.sort((a, b) => b.score - a.score);
            // Keep top 15 entries
            board = board.slice(0, 15);

            try {
                localStorage.setItem('arjuna_wayang_scores', JSON.stringify(board));
            } catch(e) {}
        }

        function renderLeaderboardScreen() {
            showHeader(false);
            const board = getLeaderboard();
            const app = document.getElementById('appContainer');

            app.innerHTML = `
                <div class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-3xl border-amber-500/40">
                    <div class="flex items-center justify-between mb-6 border-b border-amber-500/30 pb-4">
                        <div class="flex items-center space-x-3">
                            <span class="text-3xl">🏆</span>
                            <div>
                                <h2 class="font-heading text-2xl md:text-3xl font-bold text-amber-400">PAPAN SKOR</h2>
                                <p class="text-xs text-amber-200/70">Para Petualang Wayang Jawa Terbaik</p>
                            </div>
                        </div>
                        <button onclick="playSound('click'); renderHomeScreen();" class="p-2.5 bg-slate-800 hover:bg-slate-700 text-amber-300 rounded-xl text-xs border border-amber-500/30 btn-game">
                            🏠 BERANDA
                        </button>
                    </div>

                    <div class="overflow-x-auto mb-6">
                        <table class="w-full text-left text-xs md:text-sm">
                            <thead>
                                <tr class="bg-amber-500/20 text-amber-300 font-heading border-b border-amber-500/30">
                                    <th class="p-3">Peringkat</th>
                                    <th class="p-3">Nama Pemain</th>
                                    <th class="p-3">Mode</th>
                                    <th class="p-3">Skor</th>
                                    <th class="p-3">Gelar</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800 text-slate-200">
                                ${board.length > 0 ? board.map((item, index) => {
                                    let rankBadge = `${index + 1}`;
                                    if (index === 0) rankBadge = '🥇 Juara 1';
                                    else if (index === 1) rankBadge = '🥈 Juara 2';
                                    else if (index === 2) rankBadge = '🥉 Juara 3';

                                    return `
                                        <tr class="hover:bg-slate-900/50">
                                            <td class="p-3 font-bold ${index < 3 ? 'text-amber-300 font-heading' : ''}">${rankBadge}</td>
                                            <td class="p-3 font-semibold">${item.name}</td>
                                            <td class="p-3"><span class="px-2 py-0.5 rounded bg-slate-800 text-[10px] font-bold text-amber-400">${item.mode}</span></td>
                                            <td class="p-3 font-heading font-bold text-amber-300">⭐ ${item.score}</td>
                                            <td class="p-3 text-xs text-amber-200/80">${item.badge === 'Pangerten Wayang Jawa' ? '🏆 ' : '⭐ '}${item.badge}</td>
                                        </tr>
                                    `;
                                }).join('') : `
                                    <tr>
                                        <td colspan="5" class="p-6 text-center text-slate-400">
                                            Durung ana data papan skor. Ayo dadi petualang pisanan!
                                        </td>
                                    </tr>
                                `}
                            </tbody>
                        </table>
                    </div>

                    <div class="flex justify-between items-center">
                        <button onclick="playSound('click'); renderHomeScreen();" class="py-3 px-6 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl border border-amber-500/30 btn-game">
                            🏠 KEMBALI KE BERANDA
                        </button>
                        <button onclick="playSound('click'); renderRegistrationScreen();" class="py-3 px-6 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-heading rounded-xl btn-game">
                            🔄 MAIN LAGI
                        </button>
                    </div>
                </div>
            `;
        }
    </script>
</body>
</html>
