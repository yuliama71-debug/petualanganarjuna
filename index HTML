    <script>
        /* ========================================================
           VIEW H: HALAMAN PETA PETUALANGAN (MAP)
           ======================================================== */
        function renderMapScreen() {
            showHeader(true);
            updateHeaderUI();

            const player = getCurrentPlayer();
            const app = document.getElementById('appContainer');

            const levelsInfo = [
                { id: 1, name: 'LEVEL 1 — KENALI TOKOH', desc: 'Cocokna gambar tokoh lan jenenge', icon: '🏹' },
                { id: 2, name: 'LEVEL 2 — TEBAK SIFAT', desc: 'Tebak watak lan karakter tokoh', icon: '🧠' },
                { id: 3, name: 'LEVEL 3 — PASANGKAN', desc: 'Pasangake watak karo tokoh wayang', icon: '🧩' },
                { id: 4, name: 'LEVEL 4 — BOSS BATTLE', desc: 'Tantangan Pamungkas Kerajaan Jawa', icon: '⚔️' }
            ];

            app.innerHTML = `
                <div class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-2xl border-amber-500/40 text-center">
                    <div class="mb-6">
                        <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold">PETA PERJALANAN</span>
                        <h2 class="font-heading text-2xl md:text-3xl font-extrabold text-amber-300 mt-1">
                            ${player.name}, MIWITI PETUALANGAN!
                        </h2>
                        <p class="text-xs text-slate-300">Pilih level sing wis terbuka kanggo miwiti misi.</p>
                    </div>

                    <!-- Path Map -->
                    <div class="space-y-4 relative py-2">
                        ${levelsInfo.map((lvl) => {
                            const isUnlocked = player.unlockedLevel >= lvl.id;
                            return `
                                <div class="relative z-10 flex items-center">
                                    <button onclick="${isUnlocked ? `playSound('click'); startLevel(${lvl.id});` : `playSound('wrong');`}" 
                                        class="w-full p-4 rounded-2xl border-2 flex items-center justify-between transition-all duration-200 ${isUnlocked ? 'bg-gradient-to-r from-purple-900/80 to-slate-900/80 border-amber-400 hover:scale-[1.02] shadow-lg cursor-pointer btn-game' : 'bg-slate-900/40 border-slate-700 opacity-60 cursor-not-allowed'}">
                                        <div class="flex items-center space-x-4">
                                            <div class="w-12 h-12 rounded-xl ${isUnlocked ? 'bg-amber-500/20 border border-amber-400 text-amber-300' : 'bg-slate-800 border border-slate-700 text-slate-500'} flex items-center justify-center text-2xl font-heading">
                                                ${lvl.icon}
                                            </div>
                                            <div class="text-left">
                                                <h3 class="font-heading font-bold text-base md:text-lg ${isUnlocked ? 'text-amber-300' : 'text-slate-400'}">${lvl.name}</h3>
                                                <p class="text-xs text-slate-300">${lvl.desc}</p>
                                            </div>
                                        </div>

                                        <div>
                                            ${isUnlocked ? '<span class="px-3 py-1 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-bold rounded-full">TERBUKA</span>' : '<span class="text-2xl">🔒</span>'}
                                        </div>
                                    </button>
                                </div>
                            `;
                        }).join('')}
                    </div>

                    <div class="mt-8 pt-4 border-t border-amber-500/20 flex justify-between items-center">
                        <button onclick="playSound('click'); renderRegistrationScreen();" class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                            ⬅️ GANTI PEMAIN
                        </button>
                        <button onclick="playSound('click'); renderHomeScreen();" class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl text-xs border border-amber-500/30 btn-game">
                            🏠 BERANDA
                        </button>
                    </div>
                </div>
            `;
        }

        function startLevel(lvlNum) {
            if (lvlNum === 1) initLevel1();
            else if (lvlNum === 2) initLevel2();
            else if (lvlNum === 3) initLevel3();
            else if (lvlNum === 4) initBossBattle();
        }

        /* ========================================================
           VIEW I: LEVEL 1 — KENALI TOKOH
           ======================================================== */
        function initLevel1() {
            // Generate 10 randomized questions from character list
            const charKeys = Object.keys(CHARACTERS);
            gameState.level1Questions = [];
            for (let i = 0; i < 10; i++) {
                const targetKey = charKeys[Math.floor(Math.random() * charKeys.length)];
                const targetChar = CHARACTERS[targetKey];
                
                // Get 3 wrong distractors
                const wrongKeys = charKeys.filter(k => k !== targetKey);
                const shuffledWrong = wrongKeys.sort(() => 0.5 - Math.random()).slice(0, 3);
                const options = [targetChar, ...shuffledWrong.map(k => CHARACTERS[k])].sort(() => 0.5 - Math.random());

                gameState.level1Questions.push({
                    target: targetChar,
                    options: options
                });
            }

            gameState.level1Index = 0;
            renderLevel1Question();
        }

        function renderLevel1Question() {
            showHeader(true);
            updateHeaderUI();

            const player = getCurrentPlayer();
            if (player.lives <= 0) {
                renderGameOverScreen(1);
                return;
            }

            if (gameState.level1Index >= gameState.level1Questions.length) {
                // Level 1 Complete!
                playSound('levelup');
                if (player.unlockedLevel < 2) player.unlockedLevel = 2;
                renderLevelCompleteScreen(1, "🎉 LEVEL 1 RAMPUNG!", "Kowe wis bisa ngenali paraga Pandhawa lan Punakawan kanthi cetha.", 2);
                return;
            }

            const currentQ = gameState.level1Questions[gameState.level1Index];
            const app = document.getElementById('appContainer');

            app.innerHTML = `
                <div class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-2xl border-amber-500/40 text-center">
                    <div class="flex justify-between items-center mb-4 border-b border-amber-500/20 pb-3">
                        <div class="text-left">
                            <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">🏹 LEVEL 1 — KENALI TOKOH</span>
                            <h2 class="font-heading text-lg md:text-xl font-bold text-slate-100">Sapa jeneng paraga iki?</h2>
                        </div>
                        <div class="px-3 py-1 bg-amber-500/20 border border-amber-400/40 rounded-full text-amber-300 font-heading font-bold text-xs">
                            Soal ${gameState.level1Index + 1} / 10
                        </div>
                    </div>

                    <!-- Character Image -->
                    <div class="my-4 flex justify-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 bg-slate-900/80 rounded-2xl p-2 border-2 border-amber-500/40 flex items-center justify-center shadow-xl">
                            ${getWayangSVG(currentQ.target.id, '100%', '100%')}
                        </div>
                    </div>

                    <!-- 4 Multiple Choice Options -->
                    <div class="grid grid-cols-2 gap-3 md:gap-4 mt-6">
                        ${currentQ.options.map((opt) => `
                            <button onclick="checkLevel1Answer('${opt.id}')" class="p-4 bg-slate-900/80 hover:bg-amber-600/30 border border-amber-500/30 hover:border-amber-400 rounded-xl font-heading font-bold text-slate-100 hover:text-amber-300 text-base md:text-lg transition-all btn-game">
                                ${opt.name}
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function checkLevel1Answer(selectedId) {
            const currentQ = gameState.level1Questions[gameState.level1Index];
            const player = getCurrentPlayer();

            if (selectedId === currentQ.target.id) {
                player.score += 10;
                showFeedbackModal(true, "✅ BENER!", `Pancen bener! Paraga iki yaiku ${currentQ.target.name}. (+10 Poin)`, () => {
                    gameState.level1Index++;
                    renderLevel1Question();
                });
            } else {
                player.lives -= 1;
                showFeedbackModal(false, "❌ DURUNG BENER!", `Jawaban sing bener yaiku ${currentQ.target.name}. (-1 Nyawa)`, () => {
                    gameState.level1Index++;
                    renderLevel1Question();
                });
            }
        }
    </script>

    <script>
        /* ========================================================
           VIEW J: LEVEL 2 — TEBAK SIFAT
           ======================================================== */
        function initLevel2() {
            // Shuffle questions bank
            gameState.level2Questions = [...LEVEL2_QUESTIONS_BANK].sort(() => 0.5 - Math.random());
            gameState.level2Index = 0;
            renderLevel2Question();
        }

        function renderLevel2Question() {
            showHeader(true);
            updateHeaderUI();

            const player = getCurrentPlayer();
            if (player.lives <= 0) {
                renderGameOverScreen(2);
                return;
            }

            if (gameState.level2Index >= gameState.level2Questions.length) {
                playSound('levelup');
                if (player.unlockedLevel < 3) player.unlockedLevel = 3;
                renderLevelCompleteScreen(2, "🎉 LEVEL 2 RAMPUNG!", "Kowe wis luwih ngerti watak para paraga wayang Jawa.", 3);
                return;
            }

            const currentQ = gameState.level2Questions[gameState.level2Index];
            const app = document.getElementById('appContainer');

            app.innerHTML = `
                <div class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-2xl border-amber-500/40 text-center">
                    <div class="flex justify-between items-center mb-4 border-b border-amber-500/20 pb-3">
                        <div class="text-left">
                            <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">🧠 LEVEL 2 — TEBAK SIFAT</span>
                            <h2 class="font-heading text-lg md:text-xl font-bold text-slate-100">Kenali watak para paraga!</h2>
                        </div>
                        <div class="px-3 py-1 bg-amber-500/20 border border-amber-400/40 rounded-full text-amber-300 font-heading font-bold text-xs">
                            Soal ${gameState.level2Index + 1} / 10
                        </div>
                    </div>

                    <!-- Question Prompt Box -->
                    <div class="my-6 p-6 bg-slate-900/90 rounded-2xl border-2 border-amber-500/30 text-slate-100">
                        <p class="text-lg md:text-xl font-semibold leading-relaxed">
                            "${currentQ.question}"
                        </p>
                    </div>

                    <!-- 4 Multiple Choice Options -->
                    <div class="grid grid-cols-2 gap-3 md:gap-4">
                        ${currentQ.options.map((optId) => {
                            const char = CHARACTERS[optId];
                            return `
                                <button onclick="checkLevel2Answer('${optId}')" class="p-4 bg-slate-900/80 hover:bg-amber-600/30 border border-amber-500/30 hover:border-amber-400 rounded-xl font-heading font-bold text-slate-100 hover:text-amber-300 text-base md:text-lg transition-all btn-game flex items-center justify-center space-x-2">
                                    <span>${char.name}</span>
                                </button>
                            `;
                        }).join('')}
                    </div>
                </div>
            `;
        }

        function checkLevel2Answer(selectedId) {
            const currentQ = gameState.level2Questions[gameState.level2Index];
            const player = getCurrentPlayer();
            const targetChar = CHARACTERS[currentQ.correct];

            if (selectedId === currentQ.correct) {
                player.score += 10;
                showFeedbackModal(true, "✅ PANCEN BENER!", `Bener banget! ${targetChar.name} iku ${targetChar.desc} (+10 Poin)`, () => {
                    gameState.level2Index++;
                    renderLevel2Question();
                });
            } else {
                player.lives -= 1;
                showFeedbackModal(false, "❌ DURUNG TREP!", `Jawaban sing bener yaiku ${targetChar.name}. (-1 Nyawa)`, () => {
                    gameState.level2Index++;
                    renderLevel2Question();
                });
            }
        }

        /* ========================================================
           VIEW K: LEVEL 3 — PASANGKAN (MATCHING)
           ======================================================== */
        function initLevel3() {
            // Select 5 distinct characters for matching
            const keys = ['yudhistira', 'bima', 'arjuna', 'semar', 'gareng'];
            const chars = keys.map(k => CHARACTERS[k]);
            
            // Left column characters, Right column traits shuffled
            const traits = chars.map(c => ({
                id: c.id,
                traitText: c.traits.join(', ')
            })).sort(() => 0.5 - Math.random());

            gameState.level3Pairs = {
                characters: chars,
                traits: traits,
                matched: {}
            };
            gameState.level3SelectedChar = null;
            gameState.level3MatchedCount = 0;

            renderLevel3Screen();
        }

        function renderLevel3Screen() {
            showHeader(true);
            updateHeaderUI();

            const player = getCurrentPlayer();
            if (player.lives <= 0) {
                renderGameOverScreen(3);
                return;
            }

            if (gameState.level3MatchedCount >= 5) {
                playSound('levelup');
                if (player.unlockedLevel < 4) player.unlockedLevel = 4;
                renderLevelCompleteScreen(3, "🎉 LEVEL 3 RAMPUNG!", "Kowe wis pinter masangake watak karo paraga wayang.", 4);
                return;
            }

            const app = document.getElementById('appContainer');
            const data = gameState.level3Pairs;

            app.innerHTML = `
                <div class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-4xl border-amber-500/40 text-center">
                    <div class="mb-4 border-b border-amber-500/20 pb-3">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">🧩 LEVEL 3 — PASANGKAN</span>
                        <h2 class="font-heading text-lg md:text-xl font-bold text-slate-100">Pasangna watak karo paraga sing trep!</h2>
                        <p class="text-xs text-amber-200/70">Klik paraga ing sisih kiwa, banjur klik watak sing cocog ing sisih tengen.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-4 text-left">
                        <!-- Left Column: Characters -->
                        <div class="space-y-3">
                            <h3 class="font-heading text-amber-300 font-bold text-sm uppercase">1. Paraga Wayang:</h3>
                            ${data.characters.map(c => {
                                const isMatched = data.matched[c.id];
                                const isSelected = gameState.level3SelectedChar === c.id;

                                return `
                                    <button onclick="${!isMatched ? `selectLevel3Char('${c.id}')` : ''}" 
                                        class="w-full p-3 rounded-2xl border-2 flex items-center justify-between transition-all ${isMatched ? 'bg-emerald-950/60 border-emerald-500/50 opacity-60 cursor-default' : isSelected ? 'bg-amber-500/30 border-amber-400 shadow-lg scale-102' : 'bg-slate-900/80 border-slate-700 hover:border-amber-500/50 btn-game'}">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-12 h-12 bg-slate-800 rounded-xl p-1 flex-shrink-0">
                                                ${getWayangSVG(c.id, '100%', '100%')}
                                            </div>
                                            <div>
                                                <h4 class="font-heading font-bold text-amber-200 text-base">${c.name}</h4>
                                                <p class="text-[11px] text-slate-300">${c.group}</p>
                                            </div>
                                        </div>
                                        <div>
                                            ${isMatched ? '<span class="text-emerald-400 font-bold text-xl">✅</span>' : isSelected ? '<span class="text-amber-400 text-xs font-bold">DIPILIH</span>' : '<span class="text-slate-500 text-xs">➡️</span>'}
                                        </div>
                                    </button>
                                `;
                            }).join('')}
                        </div>

                        <!-- Right Column: Traits -->
                        <div class="space-y-3">
                            <h3 class="font-heading text-amber-300 font-bold text-sm uppercase">2. Watak / Sifat:</h3>
                            ${data.traits.map(t => {
                                const isMatched = Object.values(data.matched).includes(t.id);

                                return `
                                    <button onclick="${!isMatched ? `matchLevel3Trait('${t.id}')` : ''}" 
                                        class="w-full p-4 rounded-2xl border-2 transition-all ${isMatched ? 'bg-emerald-950/60 border-emerald-500/50 opacity-60 cursor-default' : 'bg-slate-900/80 border-slate-700 hover:border-amber-400 btn-game'}">
                                        <div class="flex items-center justify-between">
                                            <span class="font-semibold text-slate-100 text-sm md:text-base capitalize">${t.traitText}</span>
                                            ${isMatched ? '<span class="text-emerald-400 font-bold text-xl">✅</span>' : '<span class="text-slate-500 text-xs">🎯</span>'}
                                        </div>
                                    </button>
                                `;
                            }).join('')}
                        </div>
                    </div>
                </div>
            `;
        }

        function selectLevel3Char(charId) {
            playSound('click');
            gameState.level3SelectedChar = charId;
            renderLevel3Screen();
        }

        function matchLevel3Trait(traitCharId) {
            if (!gameState.level3SelectedChar) {
                playSound('wrong');
                showFeedbackModal(false, "⚠️ PILIH PARAGA DHISEK!", "Klik salah siji paraga ing sisih kiwa dhisik!", () => {});
                return;
            }

            const player = getCurrentPlayer();
            const charId = gameState.level3SelectedChar;

            if (charId === traitCharId) {
                // Correct Match
                player.score += 10;
                gameState.level3Pairs.matched[charId] = traitCharId;
                gameState.level3MatchedCount++;
                gameState.level3SelectedChar = null;

                showFeedbackModal(true, "✅ PASANGAN BENER!", `Pancen trep! (+10 Poin)`, () => {
                    renderLevel3Screen();
                });
            } else {
                // Wrong Match
                player.lives -= 1;
                showFeedbackModal(false, "❌ DURUNG TREP!", `Watak iki ora cocog karo paraga sing dipilih. (-1 Nyawa)`, () => {
                    renderLevel3Screen();
                });
            }
        }
    </script>

    <script>
        /* ========================================================
           VIEW L: LEVEL 4 — BOSS BATTLE
           ======================================================== */
        function initBossBattle() {
            gameState.bossIndex = 0;
            renderBossQuestion();
        }

        function renderBossQuestion() {
            showHeader(true);
            updateHeaderUI();

            const player = getCurrentPlayer();
            if (player.lives <= 0) {
                renderGameOverScreen(4);
                return;
            }

            if (gameState.bossIndex >= BOSS_QUESTIONS_BANK.length) {
                // Completed Boss Battle!
                playSound('victory');
                triggerConfetti();
                renderFinalResultsScreen();
                return;
            }

            const currentQ = BOSS_QUESTIONS_BANK[gameState.bossIndex];
            const app = document.getElementById('appContainer');

            app.innerHTML = `
                <div class="glass-card glass-card-gold rounded-3xl p-6 md:p-8 w-full max-w-3xl border-2 border-amber-400 text-center relative overflow-hidden">
