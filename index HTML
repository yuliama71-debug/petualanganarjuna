    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #1a0f2e;
            color: #f8fafc;
            user-select: none;
            overflow-x: hidden;
        }

        .font-heading {
            font-family: 'Fredoka', cursive;
        }

        /* Javanese Batik Pattern Background */
        .batik-bg {
            background-color: #1e1338;
            background-image: radial-gradient(#d97706 0.75px, transparent 0.75px), radial-gradient(#d97706 0.75px, #1e1338 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
            background-opacity: 0.15;
        }

        /* Custom Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(1deg); }
        }

        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(245, 158, 11, 0.4); }
            50% { box-shadow: 0 0 30px rgba(245, 158, 11, 0.8); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        @keyframes starPop {
            0% { transform: scale(0) rotate(0deg); opacity: 0; }
            50% { transform: scale(1.4) rotate(180deg); opacity: 1; }
            100% { transform: scale(1) rotate(360deg); opacity: 1; }
        }

        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        .animate-glow {
            animation: pulseGlow 2.5s infinite;
        }

        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        .animate-star {
            animation: starPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(30, 20, 50, 0.85);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(245, 158, 11, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .glass-card-gold {
            background: linear-gradient(135deg, rgba(217, 119, 6, 0.2), rgba(180, 83, 9, 0.4));
            border: 2px solid #f59e0b;
        }

        /* Interactive Card Buttons */
        .btn-game {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .btn-game:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4);
        }

        .btn-game:active {
            transform: translateY(1px) scale(0.98);
        }

        /* Canvas particles layer */
        #confettiCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 100;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #110924;
        }
        ::-webkit-scrollbar-thumb {
            background: #d97706;
            border-radius: 4px;
        }
    </style>
</head>
