                            <button type="button" onclick="playSound('click'); renderHomeScreen();" class="py-3.5 px-5 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold rounded-xl border border-amber-500/30 btn-game">
                                ⬅️ BERANDA
                            </button>
                            <button type="submit" class="flex-grow py-3.5 px-6 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold font-heading text-lg rounded-xl shadow-lg btn-game">
                                MULAI BERMAIN 🏹
                            </button>
                        </div>
                    </form>
                </div>
            `;

            // Restore previously entered names if available
            document.getElementById('p1NameInput').value = gameState.players[1].name !== 'Petualang 1' ? gameState.players[1].name : '';
            if (gameState.mode === 'DUEL') {
                document.getElementById('p2NameInput').value = gameState.players[2].name !== 'Petualang 2' ? gameState.players[2].name : '';
            }
        }

        function selectGameMode(mode) {
            playSound('click');
            gameState.mode = mode;
            renderRegistrationScreen();
        }

        function handleStartGame(e) {
            e.preventDefault();
            playSound('click');

            const p1Name = document.getElementById('p1NameInput').value.trim();
            const p2Name = document.getElementById('p2NameInput') ? document.getElementById('p2NameInput').value.trim() : '';

            if (!p1Name || (gameState.mode === 'DUEL' && !p2Name)) {
                document.getElementById('validationMsg').classList.remove('hidden');
                return;
            }

            // Reset game state for fresh run
            gameState.currentPlayerIndex = 1;
            gameState.players[1] = { name: p1Name, score: 0, lives: 5, unlockedLevel: 1 };
            if (gameState.mode === 'DUEL') {
                gameState.players[2] = { name: p2Name, score: 0, lives: 5, unlockedLevel: 1 };
            }

            renderMapScreen();
