                    if (icon) icon.textContent = lvl === 1 ? "🏹" : lvl === 2 ? "🧠" : lvl === 3 ? "🧩" : "⚔️";
                } else {
                    node.className = "p-5 rounded-2xl bg-amber-950/40 border-2 border-amber-900/50 text-center space-y-3 opacity-60 pointer-events-none transition shadow-lg";
                    if (status) status.textContent = "🔒 TERKUNCI";
                    if (status) status.className = "text-xs font-bold text-amber-600 pt-1";
                    if (icon) icon.textContent = "🔒";
                }
            }
        }

        function startLevel(lvl) {
            playSound('click');
            currentLevel = lvl;
            quizCurrentIndex = 0;

            if (lvl === 1) {
                setupLevel1();
                switchScreen('screen-quiz');
            } else if (lvl === 2) {
                setupLevel2();
                switchScreen('screen-quiz');
            } else if (lvl === 3) {
                setupLevel3();
                switchScreen('screen-level3');
            } else if (lvl === 4) {
                setupLevel4();
                switchScreen('screen-quiz');
            }
        }

        /* =========================================================
           8. LEVEL 1 SETUP & LOGIC (KENALI TOKOH)
           ========================================================= */
        function setupLevel1() {
            document.getElementById('quiz-level-badge').textContent = "LEVEL 1";
            document.getElementById('quiz-title').textContent = "KENALI TOKOH";
            document.getElementById('quiz-media-box').classList.remove('hidden');

            const keys = Object.keys(WAYANG_CHARACTERS);
            // Create 10 randomized items from characters
            quizQuestionsPool = [];
            for (let i = 0; i < 10; i++) {
                const targetKey = keys[i % keys.length];
                const charObj = WAYANG_CHARACTERS[targetKey];
                
                // Get 3 incorrect options
                const wrongKeys = keys.filter(k => k !== targetKey);
                shuffleArray(wrongKeys);
                const chosenOptions = [targetKey, wrongKeys[0], wrongKeys[1], wrongKeys[2]];
                shuffleArray(chosenOptions);

                quizQuestionsPool.push({
                    targetKey: targetKey,
                    svg: charObj.svg,
                    prompt: "Sapa jeneng paraga wayang iki?",
                    correctName: charObj.name,
                    options: chosenOptions.map(k => WAYANG_CHARACTERS[k].name)
                });
            }
            shuffleArray(quizQuestionsPool);
            renderQuizQuestion();
        }

        /* =========================================================
           9. LEVEL 2 SETUP & LOGIC (TEBAK SIFAT)
           ========================================================= */
        function setupLevel2() {
            document.getElementById('quiz-level-badge').textContent = "LEVEL 2";
            document.getElementById('quiz-title').textContent = "TEBAK SIFAT";
            document.getElementById('quiz-media-box').classList.add('hidden');

            quizQuestionsPool = JSON.parse(JSON.stringify(LEVEL2_QUESTIONS));
            shuffleArray(quizQuestionsPool);
            quizQuestionsPool.forEach(q => {
                q.correctName = WAYANG_CHARACTERS[q.correct].name;
                q.options = q.options.map(k => WAYANG_CHARACTERS[k].name);
            });

            renderQuizQuestion();
        }

        /* =========================================================
           10. LEVEL 4 SETUP & LOGIC (BOSS BATTLE)
           ========================================================= */
        function setupLevel4() {
            document.getElementById('quiz-level-badge').textContent = "LEVEL 4";
            document.getElementById('quiz-title').textContent = "⚔️ BOSS BATTLE";
            document.getElementById('quiz-media-box').classList.add('hidden');

            quizQuestionsPool = JSON.parse(JSON.stringify(BOSS_QUESTIONS));
            quizQuestionsPool.forEach(q => {
                q.correctName = q.correct;
            });

            renderQuizQuestion();
        }

        /* =========================================================
           11. COMMON QUIZ RENDERER
           ========================================================= */
        function renderQuizQuestion() {
            const p = players[currentPlayerIdx];
            const currentQ = quizQuestionsPool[quizCurrentIndex];

            // Update Header Stats
            document.getElementById('quiz-progress-text').textContent = `Soal ${quizCurrentIndex + 1} / ${quizQuestionsPool.length}`;
            document.getElementById('quiz-score-text').textContent = p.score;
            document.getElementById('quiz-lives-text').textContent = p.lives;

            // Prompt & Visual
            document.getElementById('quiz-question-prompt').textContent = currentQ.prompt || currentQ.prompt;
            
            if (currentQ.svg) {
                document.getElementById('quiz-svg-holder').innerHTML = currentQ.svg;
            }

            // Hide feedback
            const fb = document.getElementById('quiz-feedback-box');
            fb.className = 'hidden p-4 rounded-xl text-center font-extrabold text-lg transition';

            // Options
            const grid = document.getElementById('quiz-options-grid');
            grid.innerHTML = '';

            currentQ.options.forEach(optText => {
                const btn = document.createElement('button');
                btn.className = "py-4 px-5 bg-amber-950/80 hover:bg-amber-900 border-2 border-amber-500/40 rounded-xl text-amber-100 font-bold text-sm md:text-base text-center transition shadow-md hover:border-amber-400 active:scale-95 flex items-center justify-center";
                btn.textContent = optText;
                btn.onclick = () => handleAnswerSelect(optText, currentQ.correctName, btn);
                grid.appendChild(btn);
            });
        }

        function handleAnswerSelect(selected, correct, buttonEl) {
            const p = players[currentPlayerIdx];
            const fb = document.getElementById('quiz-feedback-box');
            fb.classList.remove('hidden');

            const isCorrect = (selected.toLowerCase() === correct.toLowerCase());

            if (isCorrect) {
                playSound('correct');
                const points = (currentLevel === 4) ? 20 : 10;
                p.score += points;

                fb.className = "p-4 rounded-xl text-center font-extrabold text-lg bg-green-900/90 border border-green-400 text-green-200 animate-bounce";
                fb.textContent = `✅ BENER! (+${points} Poin)`;

                buttonEl.className = "py-4 px-5 bg-green-700 border-2 border-green-300 rounded-xl text-white font-bold text-sm md:text-base text-center shadow-md";
            } else {
                playSound('wrong');
                p.lives -= 1;

                fb.className = "p-4 rounded-xl text-center font-extrabold text-lg bg-red-900/90 border border-red-400 text-red-200 animate-shake";
                fb.textContent = `❌ DURUNG BENER! (-1 Nyawa)`;

                buttonEl.className = "py-4 px-5 bg-red-800 border-2 border-red-400 rounded-xl text-white font-bold text-sm md:text-base text-center shadow-md";
            }

            // Update stats HUD
            document.getElementById('quiz-score-text').textContent = p.score;
            document.getElementById('quiz-lives-text').textContent = p.lives;

            // Check game over
            if (p.lives <= 0) {
                setTimeout(() => {
                    alert("❤️ Nyawa wis telas! Ayo jajal maneh saka Peta Petualangan.");
                    p.lives = 5;
                    switchScreen('screen-map');
                }, 1000);
                return;
            }

            // Advance
            setTimeout(() => {
                quizCurrentIndex++;
                if (quizCurrentIndex < quizQuestionsPool.length) {
                    renderQuizQuestion();
                } else {
                    completeLevel(currentLevel);
                }
            }, 1200);
        }

        /* =========================================================
           12. LEVEL 3 LOGIC (PASANGKAN SIFAT)
           ========================================================= */
        function setupLevel3() {
            const p = players[currentPlayerIdx];
            document.getElementById('l3-score-text').textContent = p.score;
            document.getElementById('l3-lives-text').textContent = p.lives;

            selectedL3TokohKey = null;
            l3MatchedCount = 0;

            const selectedKeys = ['yudhistira', 'bima', 'arjuna', 'semar', 'gareng'];
            const tokohContainer = document.getElementById('l3-tokoh-list');
            const sifatContainer = document.getElementById('l3-sifat-list');

            tokohContainer.innerHTML = '';
            sifatContainer.innerHTML = '';

            // Tokoh List
            selectedKeys.forEach(key => {
                const charObj = WAYANG_CHARACTERS[key];
                const card = document.createElement('div');
                card.id = `l3-tokoh-${key}`;
                card.className = "p-3 bg-amber-950/80 border-2 border-amber-500/40 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-300 transition";
                card.onclick = () => selectL3Tokoh(key);
                card.innerHTML = `
                    <div class="w-10 h-10 rounded-lg bg-amber-900/50 p-1 border border-amber-500/30">
                        ${charObj.svg}
                    </div>
                    <span class="font-bold text-amber-200 text-sm md:text-base">${charObj.name}</span>
                `;
                tokohContainer.appendChild(card);
            });

            // Sifat Target List (Shuffled)
            const shuffledSifat = selectedKeys.map(k => ({
                key: k,
                sifat: WAYANG_CHARACTERS[k].sifat
            }));
            shuffleArray(shuffledSifat);

            shuffledSifat.forEach(item => {
                const card = document.createElement('div');
                card.id = `l3-sifat-${item.key}`;
                card.className = "p-3.5 bg-amber-950/80 border-2 border-amber-500/40 rounded-xl flex items-center justify-between cursor-pointer hover:border-amber-300 transition text-xs md:text-sm text-amber-100 font-semibold";
                card.onclick = () => selectL3SifatTarget(item.key);
                card.innerHTML = `
                    <span>👉 ${item.sifat}</span>
                    <span id="check-${item.key}" class="hidden text-green-400 font-bold text-base">✓</span>
                `;
                sifatContainer.appendChild(card);
            });
        }

        function selectL3Tokoh(key) {
            playSound('click');
            // Remove active style from all
            ['yudhistira', 'bima', 'arjuna', 'semar', 'gareng'].forEach(k => {
                const el = document.getElementById(`l3-tokoh-${k}`);
                if (el && !el.dataset.matched) {
                    el.className = "p-3 bg-amber-950/80 border-2 border-amber-500/40 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-300 transition";
                }
            });

            selectedL3TokohKey = key;
            const targetEl = document.getElementById(`l3-tokoh-${key}`);
            if (targetEl && !targetEl.dataset.matched) {
                targetEl.className = "p-3 bg-amber-600/40 border-2 border-yellow-300 rounded-xl flex items-center gap-3 cursor-pointer transition shadow-lg scale-102";
            }
        }

        function selectL3SifatTarget(sifatKey) {
            if (!selectedL3TokohKey) {
                alert("⚠️ Pilih paraga wayang ing sisih kiwa dhisik!");
                return;
            }

            const p = players[currentPlayerIdx];
            const fb = document.getElementById('l3-feedback-box');
            fb.classList.remove('hidden');

            if (selectedL3TokohKey === sifatKey) {
                playSound('correct');
                p.score += 10;
                l3MatchedCount++;

                fb.className = "p-3 rounded-xl text-center font-bold text-base bg-green-900/90 border border-green-400 text-green-200 animate-bounce";
                fb.textContent = "✅ PASANGAN BENER! (+10 Poin)";

                // Mark Tokoh
                const tEl = document.getElementById(`l3-tokoh-${selectedL3TokohKey}`);
                tEl.dataset.matched = "true";
                tEl.className = "p-3 bg-green-950/80 border-2 border-green-500 rounded-xl flex items-center gap-3 opacity-60 pointer-events-none";

                // Mark Sifat
                const sEl = document.getElementById(`l3-sifat-${sifatKey}`);
                sEl.className = "p-3.5 bg-green-950/80 border-2 border-green-500 rounded-xl flex items-center justify-between text-xs md:text-sm text-green-200 font-semibold opacity-60 pointer-events-none";
                document.getElementById(`check-${sifatKey}`).classList.remove('hidden');

                selectedL3TokohKey = null;

                document.getElementById('l3-score-text').textContent = p.score;

                if (l3MatchedCount >= 5) {
                    setTimeout(() => {
                        completeLevel(3);
                    }, 1200);
                }
            } else {
                playSound('wrong');
                p.lives -= 1;

                fb.className = "p-3 rounded-xl text-center font-bold text-base bg-red-900/90 border border-red-400 text-red-200 animate-shake";
                fb.textContent = "❌ DURUNG TREP! (-1 Nyawa)";

                document.getElementById('l3-lives-text').textContent = p.lives;

                if (p.lives <= 0) {
                    setTimeout(() => {
                        alert("❤️ Nyawa wis telas! Ayo baleni Level 3.");
                        p.lives = 5;
                        switchScreen('screen-map');
                    }, 1000);
                }
            }
        }

        /* =========================================================
           13. LEVEL COMPLETION & FLOW TRANSITIONS
           ========================================================= */
        function completeLevel(lvl) {
            playSound('victory');
            const p = players[currentPlayerIdx];

            if (lvl < 4) {
                p.unlockedLevel = Math.max(p.unlockedLevel, lvl + 1);

                document.getElementById('summary-title').textContent = `🎉 LEVEL ${lvl} RAMPUNG!`;
                document.getElementById('summary-desc').textContent = lvl === 1 
                    ? "Kowe wis kasil ngenali paraga Pandhawa lan Punakawan."
                    : lvl === 2 
                    ? "Kowe wis luwih ngerti watak lan sifat para paraga."
                    : "Kowe wis pinter masangake watak karo paraga sing trep!";

                document.getElementById('summary-score').textContent = p.score;
                document.getElementById('summary-lives').textContent = p.lives;

                switchScreen('screen-summary');
            } else {
                // Completed Level 4 (Boss Battle)
                p.completed = true;
                p.gelar = "🏆 Pangerten Wayang Jawa";
                saveScoreToLeaderboard(p);

                if (gameMode === 'DUEL' && currentPlayerIdx === 0 && players.length > 1) {
                    // Transition to Player 2
                    alert(`🎉 ${players[0].name} wis ngrampungake kabeh level!\nSaiki giliran ${players[1].name}!`);
                    currentPlayerIdx = 1;
                    switchScreen('screen-map');
                } else {
                    showFinalResultScreen();
                }
            }
        }

        function nextLevelFromSummary() {
            playSound('click');
            switchScreen('screen-map');
        }

        function showFinalResultScreen() {
            switchScreen('screen-final');

            const singleCard = document.getElementById('final-single-card');
            const duelCard = document.getElementById('final-duel-card');

            if (gameMode === 'SOLO') {
                singleCard.classList.remove('hidden');
                duelCard.classList.add('hidden');

                const p = players[0];
                document.getElementById('final-player-name').textContent = p.name;
                document.getElementById('final-player-score').textContent = p.score;
                document.getElementById('final-player-lives').textContent = p.lives;
            } else {
                singleCard.classList.add('hidden');
                duelCard.classList.remove('hidden');

                const p1 = players[0];
                const p2 = players[1];

                document.getElementById('duel-p1-name').textContent = p1.name;
                document.getElementById('duel-p1-score').textContent = `${p1.score} Pts`;

                document.getElementById('duel-p2-name').textContent = p2.name;
                document.getElementById('duel-p2-score').textContent = `${p2.score} Pts`;

                const wBox = document.getElementById('duel-winner-box');
                if (p1.score > p2.score) {
                    wBox.textContent = `🏆 PEMENANG: ${p1.name}!`;
                } else if (p2.score > p1.score) {
                    wBox.textContent = `🏆 PEMENANG: ${p2.name}!`;
                } else {
                    wBox.textContent = `🤝 HASIL IMBANG (SERI)!`;
                }
            }
        }

        function restartGame() {
            playSound('click');
            switchScreen('screen-registrasi');
        }

        /* =========================================================
           14. LOCAL STORAGE & LEADERBOARD
           ========================================================= */
        function saveScoreToLeaderboard(player) {
            try {
                let records = JSON.parse(localStorage.getItem('wayang_leaderboard') || '[]');
                records.push({
                    name: player.name,
                    mode: gameMode,
                    score: player.score,
                    gelar: player.gelar,
                    date: new Date().toLocaleDateString()
                });
                records.sort((a, b) => b.score - a.score);
                records = records.slice(0, 10); // top 10
                localStorage.setItem('wayang_leaderboard', JSON.stringify(records));
            } catch (e) {
                console.log("Localstorage error", e);
            }
        }

        function renderLeaderboardTable() {
            const tbody = document.getElementById('leaderboard-tbody');
            tbody.innerHTML = '';

            let records = [];
            try {
                records = JSON.parse(localStorage.getItem('wayang_leaderboard') || '[]');
            } catch (e) {}

            if (records.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-amber-300/60 italic">Durung ana data papan skor. Ayo main dadi sing pisanan!</td></tr>`;
                return;
            }

            records.forEach((rec, idx) => {
                const rankBadge = idx === 0 ? "🥇 Juara 1" : idx === 1 ? "🥈 Juara 2" : idx === 2 ? "🥉 Juara 3" : `#${idx + 1}`;
                const tr = document.createElement('tr');
                tr.className = "hover:bg-amber-900/30 transition";
                tr.innerHTML = `
                    <td class="p-3 font-bold text-yellow-400">${rankBadge}</td>
                    <td class="p-3 font-semibold">${escapeHTML(rec.name)}</td>
                    <td class="p-3"><span class="text-[10px] bg-amber-900 px-2 py-0.5 rounded font-bold">${rec.mode}</span></td>
                    <td class="p-3 font-black text-yellow-300">${rec.score}</td>
                    <td class="p-3 text-xs text-amber-200">${rec.gelar}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        /* Helper Utility Functions */
        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }
    </script>
