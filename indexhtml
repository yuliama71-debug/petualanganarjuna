<!DOCTYPE html>
<html lang="jv" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Arjuna: Misi Nggolèki Sifat</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans & MedievalSharp for Wayang aesthetic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Cinzel:wght@700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        jawa: {
                            gold: '#F59E0B',
                            goldlight: '#FDE047',
                            brown: '#78350F',
                            darkbrown: '#451A03',
                            red: '#DC2626',
                            deepred: '#991B1B',
                            navy: '#1E1B4B',
                            accent: '#D97706'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        wayang: ['Cinzel', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Batik Pattern Background */
        .batik-bg {
            background-color: #2a1810;
            background-image: radial-gradient(#d97706 0.75px, transparent 0.75px), radial-gradient(#d97706 0.75px, #1a0f0a 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF099 0%, #F59E0B 50%, #D97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-border {
            border: 2px solid #F59E0B;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
        }

        /* Glassmorphism visual card styling */
        .wayang-card {
            background: rgba(30, 20, 15, 0.85);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(245, 158, 11, 0.4);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Hologram glow effect for characters */
        .hologram-glow {
            filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.6));
            transition: all 0.3s ease;
        }
        
        .hologram-glow:hover {
            filter: drop-shadow(0 0 20px rgba(253, 224, 71, 0.9)) scale(1.03);
        }

        /* Float animation */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(1deg); }
        }
        .animate-float {
            animation: floatSlow 4s ease-in-out infinite;
        }

        /* Star pulse animation */
        @keyframes starPop {
            0% { transform: scale(0) rotate(-45deg); opacity: 0; }
            50% { transform: scale(1.3) rotate(10deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        .animate-star {
            animation: starPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Wrong answer shake animation */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-10px); }
            40%, 80% { transform: translateX(10px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1a0f0a;
        }
        ::-webkit-scrollbar-thumb {
            background: #d97706;
            border-radius: 4px;
        }
    </style>
</head>

<body class="batik-bg text-amber-100 font-sans h-full min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-black antialiased overflow-x-hidden">

    <!-- Audio Control Button Floating Top-Right -->
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
        <button id="soundToggleBtn" onclick="toggleAudio()" class="bg-amber-950/80 hover:bg-amber-900 text-amber-300 border border-amber-500/50 p-3 rounded-full shadow-lg transition transform active:scale-95 flex items-center justify-center w-12 h-12">
            <i id="soundIcon" class="fas fa-volume-up text-xl"></i>
        </button>
    </div>

    <!-- Main Container Container -->
    <main class="container mx-auto px-4 py-6 max-w-5xl flex-grow flex flex-col justify-center">

        <!-- ========================================================= -->
        <!-- C. HALAMAN LOADING -->
        <!-- ========================================================= -->
        <section id="screen-loading" class="flex flex-col items-center justify-center min-h-[80vh] text-center space-y-6">
            <div class="relative animate-float">
                <div class="w-48 h-48 md:w-64 md:h-64 rounded-full bg-gradient-to-b from-amber-500/20 to-transparent flex items-center justify-center border-2 border-amber-500/30 p-4">
                    <svg class="w-full h-full hologram-glow" viewBox="0 0 200 200">
                        <!-- Background Wayang Halo -->
                        <circle cx="100" cy="100" r="90" fill="#2a1810" stroke="#F59E0B" stroke-width="2" stroke-dasharray="6,6"/>
                        <!-- Authentic Arjuna Silhouette with Bow -->
                        <g transform="translate(20, 15) scale(0.8)">
                            <!-- Bow Gendhewa -->
                            <path d="M40,20 Q10,100 40,180" stroke="#F59E0B" stroke-width="5" fill="none" stroke-linecap="round"/>
                            <line x1="40" y1="20" x2="40" y2="180" stroke="#FDE047" stroke-width="1.5" stroke-dasharray="3,3"/>
                            <line x1="20" y1="100" x2="130" y2="100" stroke="#F59E0B" stroke-width="3"/>
                            <polygon points="135,100 120,93 120,107" fill="#FDE047"/>
                            
                            <!-- Arjuna Profile (Gelung Supit Urang, Jamang, Sumping) -->
                            <!-- Hairbun / Gelung -->
                            <path d="M100,30 Q130,20 140,45 Q125,65 105,55 Z" fill="#F59E0B" stroke="#451A03" stroke-width="1.5"/>
                            <path d="M125,35 Q145,25 150,45 Q135,60 120,50 Z" fill="#FDE047"/>
                            <!-- Crown Filigree (Jamang) -->
                            <path d="M85,45 Q105,35 115,50 L85,55 Z" fill="#FDE047" stroke="#78350F"/>
                            <!-- Face Liyepan profile -->
                            <path d="M85,50 Q75,60 80,75 Q85,85 92,85 Q95,75 95,65 Z" fill="#FDE047"/>
                            <!-- Eye Liyepan -->
                            <ellipse cx="83" cy="62" rx="4" ry="1.5" fill="#451A03"/>
                            <!-- Sharp Nose -->
                            <path d="M82,60 L70,72 L82,73 Z" fill="#FDE047"/>
                            <!-- Ear Ornament (Sumping) -->
                            <path d="M95,60 Q110,60 105,75 Q95,75 95,60 Z" fill="#F59E0B" stroke="#FDE047"/>
                            <!-- Neck & Torso -->
                            <path d="M88,85 L86,100 L110,100 L105,85 Z" fill="#FDE047"/>
                            <path d="M86,100 Q70,120 85,150 L115,150 Q120,120 105,100 Z" fill="#DC2626" stroke="#F59E0B" stroke-width="2"/>
                            <!-- Hands holding arrow -->
                            <path d="M85,100 L55,100 L70,110 Z" fill="#FDE047"/>
                        </g>
                    </svg>
                </div>
            </div>

            <div class="space-y-2">
                <h1 class="text-3xl md:text-5xl font-wayang font-extrabold gold-gradient-text tracking-wider">
                    🏹 PETUALANGAN ARJUNA
                </h1>
                <p class="text-xl md:text-2xl text-amber-300 font-semibold italic">
                    “MISI NGGOLÈKI SIFAT”
                </p>
                <p class="text-amber-200/80 text-sm tracking-widest uppercase">
                    Gim Edukasi Wayang Jawa Kelas 6 SD
                </p>
            </div>

            <div class="w-full max-w-md space-y-2">
                <div class="flex justify-between text-xs text-amber-300 font-bold">
                    <span id="loading-text">Nyiyapake petualangan...</span>
                    <span id="loading-percent">0%</span>
                </div>
                <div class="w-full h-4 bg-amber-950 rounded-full border border-amber-600/50 p-0.5 overflow-hidden shadow-inner">
                    <div id="loading-bar" class="h-full bg-gradient-to-r from-amber-600 via-amber-400 to-yellow-300 rounded-full transition-all duration-300 w-0"></div>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- D. HALAMAN BERANDA -->
        <!-- ========================================================= -->
        <section id="screen-home" class="hidden wayang-card rounded-3xl p-6 md:p-10 border border-amber-500/40 my-auto">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <!-- SEBELAH KIRI -->
                <div class="md:col-span-6 flex flex-col items-center text-center space-y-4 border-b md:border-b-0 md:border-r border-amber-500/20 pb-6 md:pb-0 md:pr-6">
                    <div class="relative w-44 h-44 md:w-60 md:h-60 animate-float">
                        <svg class="w-full h-full hologram-glow" viewBox="0 0 200 200">
                            <!-- Gunungan Wayang Background Frame -->
                            <path d="M100,10 C130,50 185,100 175,160 Q170,185 100,190 Q30,185 25,160 C15,100 70,50 100,10 Z" fill="#3a1c0c" stroke="#F59E0B" stroke-width="3"/>
                            <!-- Tree of Life / Kayon Ornaments -->
                            <path d="M100,30 L100,180 M100,70 L140,50 M100,90 L155,75 M100,110 L160,100 M100,70 L60,50 M100,90 L45,75 M100,110 L40,100" stroke="#D97706" stroke-width="1.5" opacity="0.6"/>
                            <!-- Wayang Kulit Arjuna Figure Overlay -->
                            <g transform="translate(45, 30) scale(0.55)">
                                <path d="M110,20 Q150,10 160,45 Q140,70 115,55 Z" fill="#F59E0B" stroke="#1A0F0A" stroke-width="2"/>
                                <path d="M90,40 Q120,25 135,45 L95,60 Z" fill="#FDE047"/>
                                <path d="M90,48 Q75,60 82,80 Q90,92 100,90 Q105,78 102,65 Z" fill="#FDE047"/>
                                <path d="M85,62 L65,76 L85,78 Z" fill="#FDE047"/>
                                <ellipse cx="83" cy="65" rx="4" ry="1.5" fill="#451A03"/>
                                <path d="M102,62 Q120,62 115,80 Q102,80 102,62 Z" fill="#F59E0B" stroke="#FDE047"/>
                                <path d="M92,90 L90,110 L120,110 L115,90 Z" fill="#FDE047"/>
                                <path d="M90,110 Q70,135 90,170 L130,170 Q140,135 120,110 Z" fill="#DC2626" stroke="#FDE047" stroke-width="3"/>
                                <!-- Bow Gendhewa -->
                                <path d="M40,30 Q0,110 40,190" stroke="#F59E0B" stroke-width="6" fill="none"/>
                                <line x1="40" y1="30" x2="40" y2="190" stroke="#FFF" stroke-width="2"/>
                            </g>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl md:text-4xl font-wayang font-black gold-gradient-text">
                            PETUALANGAN ARJUNA
                        </h1>
                        <h2 class="text-lg md:text-xl text-amber-300 font-semibold">
                            Misi Nggolèki Sifat
                        </h2>
                        <p class="text-xs text-amber-200/70 mt-2 max-w-xs mx-auto">
                            “Sinau Wayang, Ngenali Watak, Dadi Petualang!”
                        </p>
                    </div>
                </div>

                <!-- SEBELAH KANAN -->
                <div class="md:col-span-6 flex flex-col space-y-4">
                    <button onclick="switchScreen('screen-tujuan')" class="w-full py-3.5 px-5 bg-amber-950/70 hover:bg-amber-900 border border-amber-500/40 rounded-2xl text-amber-200 font-bold text-left flex items-center justify-between transition group transform hover:-translate-y-0.5">
                        <span class="flex items-center gap-3">
                            <span class="bg-amber-500/20 p-2.5 rounded-xl text-amber-400 group-hover:scale-110 transition"><i class="fas fa-book-open text-lg"></i></span>
                            <span>📚 TUJUAN PEMBELAJARAN</span>
                        </span>
                        <i class="fas fa-chevron-right text-amber-500/50 group-hover:text-amber-400"></i>
                    </button>

                    <button onclick="switchScreen('screen-petunjuk')" class="w-full py-3.5 px-5 bg-amber-950/70 hover:bg-amber-900 border border-amber-500/40 rounded-2xl text-amber-200 font-bold text-left flex items-center justify-between transition group transform hover:-translate-y-0.5">
                        <span class="flex items-center gap-3">
                            <span class="bg-amber-500/20 p-2.5 rounded-xl text-amber-400 group-hover:scale-110 transition"><i class="fas fa-gamepad text-lg"></i></span>
                            <span>🎮 PETUNJUK GIM</span>
                        </span>
                        <i class="fas fa-chevron-right text-amber-500/50 group-hover:text-amber-400"></i>
                    </button>

                    <button onclick="switchScreen('screen-leaderboard')" class="w-full py-3.5 px-5 bg-amber-950/70 hover:bg-amber-900 border border-amber-500/40 rounded-2xl text-amber-200 font-bold text-left flex items-center justify-between transition group transform hover:-translate-y-0.5">
                        <span class="flex items-center gap-3">
                            <span class="bg-amber-500/20 p-2.5 rounded-xl text-amber-400 group-hover:scale-110 transition"><i class="fas fa-trophy text-lg"></i></span>
                            <span>🏆 PAPAN SKOR</span>
                        </span>
                        <i class="fas fa-chevron-right text-amber-500/50 group-hover:text-amber-400"></i>
                    </button>

                    <div class="pt-2">
                        <button onclick="switchScreen('screen-registrasi')" class="w-full py-4 px-6 bg-gradient-to-r from-amber-600 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-400 text-amber-950 font-black text-lg rounded-2xl shadow-xl shadow-amber-600/30 flex items-center justify-center gap-3 transition transform hover:scale-105 active:scale-95 border-2 border-amber-200">
                            <i class="fas fa-play text-xl"></i>
                            <span>🏹 MULAI PETUALANGAN</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- E. TUJUAN PEMBELAJARAN -->
        <!-- ========================================================= -->
        <section id="screen-tujuan" class="hidden wayang-card rounded-3xl p-6 md:p-10 border border-amber-500/40 my-auto">
            <div class="max-w-2xl mx-auto space-y-6">
                <div class="text-center space-y-2 border-b border-amber-500/30 pb-4">
                    <h2 class="text-2xl md:text-3xl font-wayang font-bold gold-gradient-text flex items-center justify-center gap-3">
                        <span>📚</span> TUJUAN PEMBELAJARAN
                    </h2>
                    <p class="text-amber-200/90 italic font-semibold">
                        “Kanthi dolanan iki, siswa diajab bisa:”
                    </p>
                </div>

                <div class="space-y-3">
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 flex items-start gap-3">
                        <span class="bg-amber-500/20 text-amber-400 p-2 rounded-lg font-bold">1</span>
                        <p class="text-amber-100 text-sm md:text-base pt-0.5">Ngenali tokoh <strong>Pandhawa</strong> lan <strong>Punakawan</strong> kanthi bener.</p>
                    </div>
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 flex items-start gap-3">
                        <span class="bg-amber-500/20 text-amber-400 p-2 rounded-lg font-bold">2</span>
                        <p class="text-amber-100 text-sm md:text-base pt-0.5">Nyebutake jeneng paraga wayang adhedhasar gambare.</p>
                    </div>
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 flex items-start gap-3">
                        <span class="bg-amber-500/20 text-amber-400 p-2 rounded-lg font-bold">3</span>
                        <p class="text-amber-100 text-sm md:text-base pt-0.5">Ngenali sifat utawa watak utama para paraga wayang.</p>
                    </div>
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 flex items-start gap-3">
                        <span class="bg-amber-500/20 text-amber-400 p-2 rounded-lg font-bold">4</span>
                        <p class="text-amber-100 text-sm md:text-base pt-0.5">Masangake sifat karo paraga sing trep lan cocog.</p>
                    </div>
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 flex items-start gap-3">
                        <span class="bg-amber-500/20 text-amber-400 p-2 rounded-lg font-bold">5</span>
                        <p class="text-amber-100 text-sm md:text-base pt-0.5">Njupuk nilai-nilai karakter luhur saka paraga wayang kanggo urip sadina-dina.</p>
                    </div>
                </div>

                <div class="pt-4 flex justify-center">
                    <button onclick="switchScreen('screen-home')" class="py-3 px-8 bg-amber-900/80 hover:bg-amber-800 border border-amber-500/50 rounded-xl font-bold text-amber-200 flex items-center gap-2 transition transform hover:scale-105">
                        <i class="fas fa-arrow-left"></i>
                        <span>KEMBALI KE BERANDA</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- F. PETUNJUK GIM -->
        <!-- ========================================================= -->
        <section id="screen-petunjuk" class="hidden wayang-card rounded-3xl p-6 md:p-10 border border-amber-500/40 my-auto">
            <div class="max-w-2xl mx-auto space-y-6">
                <div class="text-center space-y-2 border-b border-amber-500/30 pb-4">
                    <h2 class="text-2xl md:text-3xl font-wayang font-bold gold-gradient-text flex items-center justify-center gap-3">
                        <span>🎮</span> PETUNJUK GIM
                    </h2>
                    <p class="text-amber-200/80 text-sm">
                        Tata cara lan aturan dolanan Petualangan Arjuna
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 space-y-2">
                        <h3 class="text-amber-400 font-bold text-base flex items-center gap-2">
                            <i class="fas fa-list-ol"></i> Cara Dolanan:
                        </h3>
                        <ul class="text-xs md:text-sm text-amber-100 space-y-1.5 list-disc list-inside">
                            <li>Pilih mode <strong>SOLO</strong> utawa <strong>DUEL</strong>.</li>
                            <li>Ketik jeneng pemain banjur klik <strong>MULAI BERMAIN</strong>.</li>
                            <li>Rampungake <strong>Level 1 nganti Level 4</strong> kanthi urut.</li>
                            <li>Selesaikan Boss Battle kanggo entuk gelar 🏆 <strong>“PANGERTEN WAYANG JAWA”</strong>.</li>
                        </ul>
                    </div>

                    <div class="bg-amber-950/60 p-4 rounded-xl border border-amber-500/20 space-y-2">
                        <h3 class="text-amber-400 font-bold text-base flex items-center gap-2">
                            <i class="fas fa-star-half-alt"></i> Sistem Poin & Nyawa:
                        </h3>
                        <ul class="text-xs md:text-sm text-amber-100 space-y-2">
                            <li class="flex items-center gap-2"><span class="text-red-500 text-base">❤️</span> Nyawa awal = <strong>5 Nyawa</strong></li>
                            <li class="flex items-center gap-2"><span class="text-yellow-400 text-base">⭐</span> Jawaban benar biasa = <strong>+10 poin</strong></li>
                            <li class="flex items-center gap-2"><span class="text-red-400 text-base">❌</span> Jawaban salah = <strong>-1 nyawa</strong></li>
                            <li class="flex items-center gap-2"><span class="text-amber-300 text-base">⚔️</span> Boss Battle = <strong>+20 poin / jawaban benar</strong></li>
                        </ul>
                    </div>
                </div>

                <div class="pt-4 flex justify-center">
                    <button onclick="switchScreen('screen-home')" class="py-3 px-8 bg-amber-900/80 hover:bg-amber-800 border border-amber-500/50 rounded-xl font-bold text-amber-200 flex items-center gap-2 transition transform hover:scale-105">
                        <i class="fas fa-arrow-left"></i>
                        <span>KEMBALI KE BERANDA</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- G. HALAMAN REGISTRASI -->
        <!-- ========================================================= -->
        <section id="screen-registrasi" class="hidden wayang-card rounded-3xl p-6 md:p-10 border border-amber-500/40 my-auto">
            <div class="max-w-md mx-auto space-y-6">
                <div class="text-center space-y-2">
                    <h2 class="text-2xl md:text-3xl font-wayang font-bold gold-gradient-text">
                        🏹 SIAP MIWITI PETUALANGAN?
                    </h2>
                    <p class="text-amber-200/80 text-sm">
                        Pilih mode dolanan lan isi jenengmu!
                    </p>
                </div>

                <!-- Mode Selection -->
                <div class="grid grid-cols-2 gap-4">
                    <button id="btn-mode-solo" onclick="selectGameMode('SOLO')" class="p-4 rounded-2xl border-2 transition text-center space-y-2 bg-amber-900/80 border-amber-400 shadow-lg">
                        <div class="text-3xl">🎮</div>
                        <div class="font-bold text-amber-200 text-sm md:text-base">SOLO</div>
                        <div class="text-[10px] text-amber-300/70">Main dhewe lan tantang kemampuanmu!</div>
                    </button>

                    <button id="btn-mode-duel" onclick="selectGameMode('DUEL')" class="p-4 rounded-2xl border-2 border-amber-900/50 bg-amber-950/40 transition text-center space-y-2 opacity-70 hover:opacity-100">
                        <div class="text-3xl">⚔️</div>
                        <div class="font-bold text-amber-200 text-sm md:text-base">DUEL</div>
                        <div class="text-[10px] text-amber-300/70">Main bebarengan karo kanca!</div>
                    </button>
                </div>

                <!-- Name Inputs Form -->
                <form onsubmit="handleStartGame(event)" class="space-y-4 pt-2">
                    <div id="container-player1" class="space-y-1.5">
                        <label id="label-player1" class="text-xs font-bold text-amber-300 uppercase tracking-wider block">
                            Nama Pemain:
                        </label>
                        <input type="text" id="input-player1" placeholder="Masukkan nama siswa..." maxlength="20" required class="w-full bg-amber-950/90 border border-amber-500/50 rounded-xl px-4 py-3 text-amber-100 placeholder-amber-700 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-500/30 text-sm font-semibold">
                    </div>

                    <div id="container-player2" class="space-y-1.5 hidden">
                        <label class="text-xs font-bold text-amber-300 uppercase tracking-wider block">
                            Nama Pemain 2:
                        </label>
                        <input type="text" id="input-player2" placeholder="Masukkan nama pemain 2..." maxlength="20" class="w-full bg-amber-950/90 border border-amber-500/50 rounded-xl px-4 py-3 text-amber-100 placeholder-amber-700 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-500/30 text-sm font-semibold">
                    </div>

                    <div class="pt-4 flex flex-col gap-3">
                        <button type="submit" class="w-full py-4 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-300 text-amber-950 font-black rounded-xl text-lg shadow-lg flex items-center justify-center gap-2 transition transform active:scale-95">
                            <span>🏹 MULAI BERMAIN</span>
                        </button>
                        <button type="button" onclick="switchScreen('screen-home')" class="w-full py-2.5 text-xs text-amber-300/80 hover:text-amber-200 font-semibold">
                            ⬅️ Kembali ke Beranda
                        </button>
